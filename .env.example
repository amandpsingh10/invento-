# ==============================================
# PARTS INVENTORY SYSTEM — Environment Configuration Example
# Copy to .env and fill in real values. NEVER commit .env.
# ==============================================

# ---- Database ----
# For a pooled provider (e.g. Neon), DATABASE_URL is the pooled connection
# (add &pgbouncer=true) and DIRECT_URL is the same host without "-pooler",
# used only for migrations. For a plain local/Docker Postgres, both can be
# the same value.
DATABASE_URL=postgresql://parts_inventory:parts_inventory_dev_password@localhost:5432/parts_inventory?schema=public
DIRECT_URL=postgresql://parts_inventory:parts_inventory_dev_password@localhost:5432/parts_inventory?schema=public

# ---- Backend server ----
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ---- Auth / JWT ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=change-me-cookie-secret-change-me-cookie-secret

# ---- Password hashing ----
BCRYPT_SALT_ROUNDS=12

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ---- File uploads ----
MAX_UPLOAD_SIZE_MB=10
MAX_EXCEL_ROWS=5000

# ---- Object storage (S3-compatible) ----
STORAGE_DRIVER=local
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=parts_inventory-uploads-dev
AWS_S3_ENDPOINT=

# ---- Redis (optional cache/queue) ----
REDIS_URL=redis://localhost:6379

# ---- Frontend (Vite, must be prefixed VITE_) ----
VITE_API_URL=http://localhost:4000/api

# ---- Super admin bootstrap (seed only) ----
SUPER_ADMIN_EMAIL=superadmin@parts_inventory.app
SUPER_ADMIN_PASSWORD=ChangeMe123!
